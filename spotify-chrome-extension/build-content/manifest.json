{
  "manifest_version": 3,
  "name": "Spotify Chrome Extension",
  "version": "1.0.0",
  "description": "CSDS 393 Group Project Chrome Extension",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["identity", "storage", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_end"
    }
  ]
}