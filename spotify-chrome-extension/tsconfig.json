{
  "compilerOptions": { 
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["chrome"]
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "include": ["./src/**/*"]
}
