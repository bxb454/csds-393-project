{
  "manifest_version": 3,
  "name": "Spotify Chrome Extension",
  "version": "1.0.0",
  "description": "CSDS 393 Group Project Chrome Extension",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["identity", "storage"],
  "content_scripts":[
    {
      "matches":["<all_urls>"],
      "js": ["src/theme/content-inject.js"]
    }
  ]
}